# 面板监听地址（默认仅本机）
HOST=127.0.0.1
PORT=3000

# 运行目录覆盖项。源码开发通常留空；便携入口会显式设置为包内目录。
MYSTRY_HOME=
MYSTRY_CONFIG_PATH=
MYSTRY_DATA_DIR=
# 由 mystryctl/PanelManager 注入进程指纹，手动开发通常留空
MYSTRY_PROCESS_FINGERPRINT=

# 手动启动时，JWT_SECRET、SETUP_TOKEN 和 LAUNCHER_TOKEN 应使用三个不同的
# 64 位十六进制随机值。PanelManager 会自动生成；手动生成时请分别执行三次：
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SETUP_TOKEN=
# 仅供本机 PanelManager 安全停止面板；使用另一个不同的 64 位十六进制随机值。
LAUNCHER_TOKEN=
# 纯数字按毫秒；也可写 2h / 30m / 7d
JWT_EXPIRES_IN=2h

# 精确 CORS 来源白名单，逗号分隔；不要填写 *
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 请求限流；登录仅统计密码验证失败，成功登录会清除失败计数。
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=300000

# HTTP 请求、连接、上传与文件下载生命周期（毫秒）
HTTP_REQUEST_TIMEOUT_MS=900000
HTTP_CONNECTION_TIMEOUT_MS=300000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
UPLOAD_IDLE_TIMEOUT_MS=30000
FILE_DOWNLOAD_IDLE_TIMEOUT_MS=60000

# 控制台 ticket 有效期（秒），每个 ticket 只能建立一次 WS 连接
CONSOLE_TICKET_TTL_SECONDS=60

# 文件下载 ticket 有效期（秒），每个 ticket 只能下载一次
FILE_DOWNLOAD_TICKET_TTL_SECONDS=60

# JSON、并发与任务限制
MAX_JSON_BODY_BYTES=1048576
MAX_CONCURRENT_UPLOADS=1
MAX_CONCURRENT_FILE_DOWNLOADS=4
MAX_CONCURRENT_TASKS=1
MAX_QUEUED_TASKS=2
TASK_TIMEOUT_MS=1800000
# ZIP 二阶段导入预览：默认 30 分钟有效，全局最多保留 2 个
IMPORT_PREVIEW_TTL_SECONDS=1800
MAX_IMPORT_PREVIEWS=2

# 核心下载与 Installer 限制
MAX_CORE_DOWNLOAD_BYTES=536870912
CORE_DOWNLOAD_TIMEOUT_MS=300000
MAX_CORE_METADATA_BYTES=2097152
CORE_METADATA_TIMEOUT_MS=15000
MAX_INSTALLER_OUTPUT_BYTES=65536
INSTALLER_KILL_GRACE_MS=5000

# 文本、命令与控制台缓冲限制
MAX_TEXT_FILE_BYTES=1048576
MAX_COMMAND_BYTES=4096
MAX_CONSOLE_BUFFER_BYTES=1048576
MAX_CONSOLE_CHUNK_BYTES=65536
MAX_CONSOLE_INCOMING_BYTES=4352
MAX_CONSOLE_CONNECTIONS=20
MAX_CONSOLE_COMMANDS_PER_WINDOW=60
CONSOLE_COMMAND_WINDOW_MS=60000
MAX_CONSOLE_STDIN_BYTES=65536

# 上传与 ZIP 解压配额
MAX_UPLOAD_BYTES=536870912
MAX_ZIP_ENTRIES=10000
MAX_ZIP_ENTRY_BYTES=1073741824
MAX_ZIP_UNCOMPRESSED_BYTES=2147483648
MAX_ZIP_CENTRAL_DIRECTORY_BYTES=33554432

# DATA_DIR/imports 同机目录交接配额（源目录只读，复制到托管实例）
MAX_EXISTING_IMPORT_ENTRIES=200000
MAX_EXISTING_IMPORT_BYTES=107374182400

# ModLoader args 扫描预算（列表预检 vs 导入/部署深度扫描）
MOD_LOADER_PRECHECK_MAX_DEPTH=4
MOD_LOADER_PRECHECK_MAX_ENTRIES=200
MOD_LOADER_PRECHECK_TIMEOUT_MS=250
MOD_LOADER_SCAN_MAX_DEPTH=64
MOD_LOADER_SCAN_MAX_ENTRIES=50000
MOD_LOADER_SCAN_TIMEOUT_MS=30000

# 数据目录（可为相对项目根目录的路径或绝对路径）；实例只能位于 DATA_DIR/instances/<id>
DATA_DIR=data
