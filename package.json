{
  "name": "mystry-dashboard",
  "private": true,
  "version": "0.2.0-preview.2",
  "description": "单机一体的 Minecraft 服务端 Web 管理面板",
  "license": "MIT",
  "homepage": "https://github.com/MystryWorks/mystry-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MystryWorks/mystry-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/MystryWorks/mystry-dashboard/issues"
  },
  "keywords": [
    "minecraft",
    "server",
    "panel",
    "dashboard",
    "paper",
    "fabric",
    "forge",
    "neoforge",
    "fastify",
    "react"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @mystry/server",
    "dev:web": "npm run dev -w @mystry/web",
    "build": "npm run build -w @mystry/shared && npm run build -w @mystry/server && npm run build -w @mystry/web",
    "typecheck": "npm run typecheck -w @mystry/shared && npm run typecheck -w @mystry/server && npm run typecheck -w @mystry/web",
    "knowledge:check": "node scripts/check-project-knowledge.mjs",
    "knowledge:test": "node --test scripts/check-project-knowledge.test.mjs",
    "test:static": "npm run test:static -w @mystry/server",
    "test:interaction": "npm run test:interaction -w @mystry/web",
    "test:smoke": "node --test scripts/smoke/panel-smoke.test.mjs",
    "verify": "npm run knowledge:check && npm run knowledge:test && npm run portable:test && npm run windows:test && npm run linux:test && npm run build -w @mystry/shared && npm run typecheck && npm run test:interaction && npm run test:security -w @mystry/server && npm run test:smoke && npm run test:regression -w @mystry/server && npm run build && npm run test:static",
    "audit:production": "node scripts/check-production-audit.mjs",
    "package:release": "node scripts/portable/package-release.mjs",
    "portable:package": "node scripts/portable/package-portable.mjs",
    "portable:smoke": "node scripts/portable/smoke-portable.mjs",
    "portable:checksums": "node scripts/portable/create-checksums.mjs",
    "portable:test": "node --test scripts/portable/portable.test.mjs",
    "windows:test": "node --test scripts/windows/panel-manager.test.mjs",
    "sbom": "node scripts/portable/create-sbom.mjs --output sbom.cdx.json",
    "start": "npm run start -w @mystry/server",
    "linux:test": "node --test scripts/linux/panel-manager.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "yazl": "^3.3.1"
  }
}
